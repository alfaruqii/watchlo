# ==============================================================================
# WATCHLO PRODUCTION & LOCAL ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# NOTE: All keys below are strictly SERVER-ONLY.
# Do NOT prefix sensitive keys with NEXT_PUBLIC_ to prevent leaking credentials
# into public browser JavaScript bundles.
# ==============================================================================

# Server-side access key for upstream Watchlo Anime API microservices
CUSTOM_API_KEY=your_upstream_api_key_here

# Upstream Backend API Endpoints (Server-to-Server only)
WATCHLO_API_V0=https://api.yourdomain.com/tmdb
WATCHLO_API_V1=https://api.yourdomain.com/anime/v1
WATCHLO_API_V2=https://api.yourdomain.com/anime/v2
WATCHLO_ANIME_API=https://api.yourdomain.com/anime

# Secret key used by middleware/security to sign session tokens for /api/* anti-leech protection
INTERNAL_API_SECRET=your_random_internal_secret_salt_here
